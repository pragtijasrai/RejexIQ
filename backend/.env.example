# ── RejexIQ Backend Environment Variables ──────────────────────────────────
# Copy this file to backend/.env and fill in your credentials

# JWT
JWT_SECRET=rejexiq_dev_secret_2025
SESSION_SECRET=rejexiq_session_secret_2025

# Frontend URL (for OAuth redirects)
CLIENT_URL=http://localhost:5173

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Microsoft OAuth ───────────────────────────────────────────────────────────
# Get from: https://portal.azure.com → App registrations
# Redirect URI: http://localhost:5000/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
