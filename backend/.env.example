# ── RejexIQ Backend Environment Variables ──────────────────────────────────
# Copy this file to backend/.env and fill in your credentials

# JWT
JWT_SECRET=rejexiq_dev_secret_2025
JWT_EXPIRES=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB (optional — falls back to in-memory if not set)
# Get a free cluster at https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/rejexiq?retryWrites=true&w=majority

# Port
PORT=5000
